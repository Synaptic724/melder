## 17) Quick “starter template” you can keep and expand

```python
import kuzu
import pandas as pd

def open_db(path="example.kuzu"):
    db = kuzu.Database(path)
    conn = kuzu.Connection(db)
    return db, conn

def bootstrap_schema(conn):
    conn.execute("""
        CREATE NODE TABLE IF NOT EXISTS Person(
            name STRING PRIMARY KEY,
            age  INT64
        );
    """)
    conn.execute("""
        CREATE REL TABLE IF NOT EXISTS Knows(
            FROM Person TO Person,
            since INT64
        );
    """)

def ingest_people(conn):
    df = pd.DataFrame({"name":["Alice","Bob","Charlie"], "age":[30,40,25]})
    conn.execute("COPY Person FROM df")

def connect_people(conn):
    conn.execute("""
        MATCH (a:Person), (b:Person)
        WHERE a.name='Alice' AND b.name='Bob'
        CREATE (a)-[:Knows {since: 2020}]->(b);
    """)

def query(conn):
    res = conn.execute("""
        MATCH (a:Person)-[k:Knows]->(b:Person)
        RETURN a.name, b.name, k.since;
    """)
    print(res.get_all())

if __name__ == "__main__":
    db, conn = open_db()
    bootstrap_schema(conn)
    ingest_people(conn)
    connect_people(conn)
    query(conn)
```

* The `CREATE NODE TABLE` / `CREATE REL TABLE` / `COPY` patterns match Kuzu’s Python API docs. ([Kuzu][4])
* If you run into performance questions, start with `PROFILE` and look at join order and adjacency direction. ([Kuzu][12])


+def _m2_annotate_positional(*, rows, spell_lookup):
+    """PROTOTYPE (melder_2, VM copy only): mark the signature-order prefix of dependency params a class takes positionally."""
+    import inspect as _inspect
+    out = []
+    for row in rows:
+        row = dict(row)
+        names = ()
+        spell = spell_lookup.get(row["spell_id"])
+        shape = row_inlinable_common_shape(row) if row.get("spell_is_callable") is not None else None
+        if spell is not None and shape is not None and isinstance(spell.spell, type):
+            try:
+                params = list(_inspect.signature(spell.spell).parameters.values())
+            except (TypeError, ValueError):
+                params = []
+            dep_names = {name for name, _keys in shape}
+            prefix = []
+            for param in params:
+                if param.kind in (param.POSITIONAL_ONLY, param.POSITIONAL_OR_KEYWORD) and param.name in dep_names:
+                    prefix.append(param.name)
+                else:
+                    break
+            names = tuple(prefix)
+        row["_m2_positional_names"] = names
+        out.append(row)
+    return tuple(out)

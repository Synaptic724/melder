+PARITY_CASES: dict[str, dict[str, Any]] = {
+    "native_policy": {
+        "existence": Existence.many, "permissions": "read", "spellframe": "parity",
+        "binding_name": "named", "profile": "detailed",
+    },
+    "not_resolvable": {"existence": "unique", "permissions": "create", "resolvable": False},

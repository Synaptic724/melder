+METADATA_REACHABLE_RESERVED_KEYS: list[str] = [
+    "_lifecycle_hooks", "aetheric_frame", "configured_disposal_method_names",
+    "enforce_priority_disposal_methods", "existing_object", "implemented_protocols", "self", "spell",

    classDef phase fill:#e8f0ff,stroke:#315a99,color:#10213d,stroke-width:2px
    classDef governance fill:#f4eaff,stroke:#7552a3,color:#35214f,stroke-width:2px
    classDef gate fill:#e7f7fa,stroke:#287a88,color:#123b43,stroke-width:2px
    classDef law fill:#fff0e8,stroke:#a4552a,color:#4a2411,stroke-width:2px
    class threads actor
    class locks,safeguard,threadlocal,immutable local
    class book_lock,run_lock,scheduler,barrier phase
    class mediator,claims,parallel,waiting governance
    class creation,rift,load,drain gate
    class law,excluded law
